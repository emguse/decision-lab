{
  "name": "jev-query",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run build && npm test",
    "test:live": "tsx scripts/live.ts",
    "format": "prettier --write src server shared scripts tests *.ts *.json",
    "format:check": "prettier --check src server shared scripts tests *.ts *.json",
    "test:local": "tsx scripts/local.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "dotenv": "^17.2.0",
    "hono": "^4.9.0",
    "markdown-it": "^15.0.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "smol-toml": "^1.9.0",
    "yaml": "^2.9.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.3"
  },
  "license": "MIT"
}
